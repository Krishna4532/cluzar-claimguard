# Application Environment
APP_ENV=development

# Database Configuration
# Replace the placeholders with your local PostgreSQL connection details.
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE_NAME

# LLM API Keys (Optional for initial development and local embeddings)
OPENAI_API_KEY=
GROQ_API_KEY=
